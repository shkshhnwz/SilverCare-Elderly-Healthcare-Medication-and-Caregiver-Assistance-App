generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  firstName String
  lastName  String
  email     String?  @unique
  phone     String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Care Circle relationships
  patientCircles CareCircle[] @relation("CirclePatient")
  ownedCircles   CareCircle[] @relation("CircleOwner")

  // Memberships in other people's Care Circles
  memberships CareCircleMember[]

  // Invitations sent by this user
  sentInvitations Invitation[] @relation("InvitationSender")

  // Consents granted by this user
  consentsGranted Consent[] @relation("ConsentGranter")

  // Audit actions performed by this user
  auditLogs AuditLog[]

  // Medication relationships
  medicationsAsPatient Medication[]     @relation("MedicationPatient")
  medicationsCreated   Medication[]     @relation("MedicationCreator")
  medicationDoseEvents MedicationDose[] @relation("DoseAcknowledgedBy")

  // Vitals relationships
  vitalReadingsRecorded   VitalReading[]   @relation("VitalRecordedBy")
  vitalReadingsAsPatient  VitalReading[]   @relation("VitalPatient")
  vitalThresholds         VitalThreshold[] @relation("ThresholdPatient")
  vitalThresholdsSet      VitalThreshold[] @relation("ThresholdSetBy")
  vitalAlerts             VitalAlert[]     @relation("AlertPatient")
  vitalAlertsAcknowledged VitalAlert[]     @relation("AlertAcknowledgedBy")

   // Location & Geofencing relationships
  safeZonesCreated          SafeZone[]        @relation("SafeZoneCreator")
  safeZonesAsPatient        SafeZone[]        @relation("SafeZonePatient")
  locationPings             LocationPing[]    @relation("LocationPingPatient")
  trackingSessionsAsPatient TrackingSession[] @relation("TrackingSessionPatient")
  trackingSessionsInitiated TrackingSession[] @relation("TrackingSessionInitiator")
  locationAlerts            LocationAlert[]   @relation("LocationAlertPatient")
  locationAlertsResolved    LocationAlert[]   @relation("LocationAlertResolver")
  
}


model CareCircle {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  patientId String   @db.Uuid
  ownerId   String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient     User               @relation("CirclePatient", fields: [patientId], references: [id])
  owner       User               @relation("CircleOwner", fields: [ownerId], references: [id])
  memberships CareCircleMember[]
  invitations Invitation[]
  consents    Consent[]
  auditLogs   AuditLog[]
  medications Medication[]

  @@index([patientId])
  @@index([ownerId])
}

model Medication {
  id                String   @id @default(uuid()) @db.Uuid
  patientId         String   @db.Uuid
  createdById       String   @db.Uuid
  careCircleId      String?  @db.Uuid
  medicationName    String
  dosage            String
  route             String
  frequencyRRule    String
  prescribingDoctor String
  refillQuantity    Int
  refillThresholdDays Int    @default(5)
  startsAt          DateTime @default(now())
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  patient   User       @relation("MedicationPatient", fields: [patientId], references: [id])
  createdBy User       @relation("MedicationCreator", fields: [createdById], references: [id])
  careCircle CareCircle? @relation(fields: [careCircleId], references: [id], onDelete: SetNull)
  doses     MedicationDose[]

  @@index([patientId])
  @@index([createdById])
  @@index([careCircleId])
  @@index([active])
}

model MedicationDose {
  id             String                   @id @default(uuid()) @db.Uuid
  medicationId   String                   @db.Uuid
  scheduledAt    DateTime
  state          MedicationDoseState      @default(SCHEDULED)
  escalationStep Int                      @default(0)
  acknowledgedById String?                @db.Uuid
  acknowledgedAt DateTime?
  confirmationType MedicationConfirmationType?
  evidenceUrl    String?
  note           String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  medication     Medication               @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  acknowledgedBy User?                    @relation("DoseAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([medicationId])
  @@index([scheduledAt])
  @@index([state])
}

model CareCircleMember {
  id        String       @id @default(uuid()) @db.Uuid
  circleId  String       @db.Uuid
  userId    String       @db.Uuid
  roleId    String       @db.Uuid
  status    MemberStatus @default(ACTIVE)
  joinedAt  DateTime     @default(now())
  revokedAt DateTime?

  circle   CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role       @relation(fields: [roleId], references: [id])
  consents Consent[]

  @@unique([circleId, userId])
  @@index([userId])
  @@index([circleId])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())

  memberships     CareCircleMember[]
  rolePermissions RolePermission[]
  invitations     Invitation[]
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Invitation {
  id          String           @id @default(uuid()) @db.Uuid
  circleId    String           @db.Uuid
  invitedById String           @db.Uuid
  roleId      String           @db.Uuid
  email       String?
  phone       String?
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  circle    CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  invitedBy User       @relation("InvitationSender", fields: [invitedById], references: [id])
  role      Role       @relation(fields: [roleId], references: [id])

  @@index([circleId])
  @@index([email])
  @@index([phone])
  @@index([expiresAt])
}

model Consent {
  id          String        @id @default(uuid()) @db.Uuid
  circleId    String        @db.Uuid
  memberId    String        @db.Uuid
  grantedById String        @db.Uuid
  status      ConsentStatus @default(GRANTED)
  scope       Json
  grantedAt   DateTime      @default(now())
  revokedAt   DateTime?
  expiresAt   DateTime?

  circle    CareCircle       @relation(fields: [circleId], references: [id], onDelete: Cascade)
  member    CareCircleMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  grantedBy User             @relation("ConsentGranter", fields: [grantedById], references: [id])

  @@index([circleId])
  @@index([memberId])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @db.Uuid
  circleId     String?  @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  actor  User        @relation(fields: [actorId], references: [id])
  circle CareCircle? @relation(fields: [circleId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([circleId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

enum RoleName {
  OWNER
  CAREGIVER_FULL
  CAREGIVER_VIEW
  PROFESSIONAL
  PHYSICIAN
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ConsentStatus {
  GRANTED
  REVOKED
  EXPIRED
}

enum MedicationDoseState {
  SCHEDULED
  NOTIFIED
  CONFIRMED_TAKEN
  CONFIRMED_SKIPPED
  MISSED
  ESCALATED
}

enum MedicationConfirmationType {
  TAP
  PHOTO
  VOICE
}

enum VitalType {
  BLOOD_PRESSURE
  GLUCOSE
  WEIGHT
  OXYGEN_SATURATION
  TEMPERATURE
  HEART_RATE
}

enum VitalSource {
  MANUAL
  BLE_DEVICE
  WEARABLE
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnomalyType {
  CRITICAL_SPIKE
  CONSECUTIVE_BREACH
  BASELINE_DEVIATION
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model VitalReading {
  id               String       @id @default(uuid()) @db.Uuid
  patientId        String       @db.Uuid
  vitalType        VitalType
  source           VitalSource  @default(MANUAL)

  // Vital Values
  systolic         Float?
  diastolic        Float?
  value            Float?
  unit             String

  // Context & Metadata
  context          String?
  notes            String?

  // BLE / Wearable Metadata
  deviceModel      String?
  deviceMacAddress String?
  rawBlePayload    Json?

  recordedAt       DateTime     @default(now())
  createdById      String       @db.Uuid
  createdAt        DateTime     @default(now())

  patient          User         @relation("VitalPatient", fields: [patientId], references: [id], onDelete: Cascade)
  createdBy        User         @relation("VitalRecordedBy", fields: [createdById], references: [id])
  alerts           VitalAlert[]

  @@index([patientId, vitalType, recordedAt])
  @@index([patientId, recordedAt])
}

model VitalThreshold {
  id                       String    @id @default(uuid()) @db.Uuid
  patientId                String    @db.Uuid
  vitalType                VitalType

  // Normal Target Range
  minNormal                Float?
  maxNormal                Float?
  systolicMin              Float?
  systolicMax              Float?
  diastolicMin             Float?
  diastolicMax             Float?

  // Critical Limits
  criticalMin              Float?
  criticalMax              Float?

  // Dynamic Anomaly Detection Parameters
  consecutiveBreachLimit   Int       @default(3)
  rollingBaselineDays      Int       @default(7)
  baselineDeviationPercent Float     @default(20.0)

  updatedById              String    @db.Uuid
  isActive                 Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  patient                  User      @relation("ThresholdPatient", fields: [patientId], references: [id], onDelete: Cascade)
  updatedBy                User      @relation("ThresholdSetBy", fields: [updatedById], references: [id])

  @@unique([patientId, vitalType])
  @@index([patientId])
}

model VitalAlert {
  id               String        @id @default(uuid()) @db.Uuid
  patientId        String        @db.Uuid
  readingId        String        @db.Uuid
  vitalType        VitalType
  severity         AlertSeverity
  anomalyType      AnomalyType
  message          String
  status           AlertStatus   @default(ACTIVE)

  // Rolling baseline snapshot at time of alert for clinical audit
  baselineSnapshot Json?

  acknowledgedById String?       @db.Uuid
  acknowledgedAt   DateTime?
  resolutionNote   String?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  patient          User          @relation("AlertPatient", fields: [patientId], references: [id], onDelete: Cascade)
  reading          VitalReading  @relation(fields: [readingId], references: [id], onDelete: Cascade)
  acknowledgedBy   User?         @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([patientId, status])
  @@index([readingId])
}

enum GeofenceAlertSeverity {
  MEDIUM
  HIGH
  CRITICAL
}

enum GeofenceAlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum TrackingSessionTrigger {
  EMERGENCY_BREACH
  MANUAL_CAREGIVER_REQUEST
  PATIENT_SOS
}

enum TrackingSessionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model SafeZone {
  id           String    @id @default(uuid()) @db.Uuid
  patientId    String    @db.Uuid
  name         String    // e.g. "Home Sanctuary", "Morning Walk Route"
  latitude     Float
  longitude    Float
  radiusMeters Float     // e.g. 100 (meters) for home, 500 for park walk
  isActive     Boolean   @default(true)
  createdById  String    @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patient      User      @relation("SafeZonePatient", fields: [patientId], references: [id], onDelete: Cascade)
  createdBy    User      @relation("SafeZoneCreator", fields: [createdById], references: [id])

  @@index([patientId, isActive])
}

model TrackingSession {
  id             String                 @id @default(uuid()) @db.Uuid
  patientId      String                 @db.Uuid
  initiatedById  String?                @db.Uuid
  triggerReason  TrackingSessionTrigger
  status         TrackingSessionStatus  @default(ACTIVE)
  startedAt      DateTime               @default(now())
  expiresAt      DateTime               // Privacy protection: hard cutoff timestamp (e.g., +30 mins)
  disclosureSent Boolean                @default(true) // Transparent disclosure notice delivered to patient
  notes          String?

  patient        User                   @relation("TrackingSessionPatient", fields: [patientId], references: [id], onDelete: Cascade)
  initiatedBy    User?                  @relation("TrackingSessionInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  pings          LocationPing[]
  alerts         LocationAlert[]

  @@index([patientId, status])
}

model LocationPing {
  id                String           @id @default(uuid()) @db.Uuid
  patientId         String           @db.Uuid
  trackingSessionId String?          @db.Uuid
  latitude          Float
  longitude         Float
  accuracyMeters    Float?
  batteryLevel      Int?
  isInsideSafeZone  Boolean          @default(true)
  recordedAt        DateTime         @default(now())

  patient           User             @relation("LocationPingPatient", fields: [patientId], references: [id], onDelete: Cascade)
  trackingSession   TrackingSession? @relation(fields: [trackingSessionId], references: [id], onDelete: SetNull)

  @@index([patientId, recordedAt])
  @@index([trackingSessionId])
}

model LocationAlert {
  id                String                @id @default(uuid()) @db.Uuid
  patientId         String                @db.Uuid
  trackingSessionId String?               @db.Uuid
  severity          GeofenceAlertSeverity @default(CRITICAL)
  status            GeofenceAlertStatus   @default(ACTIVE)
  lastKnownLat      Float
  lastKnownLng      Float
  mapUrl            String                // Direct Google Maps link for first responders / caregivers
  driftDistanceM    Float                 // Meters drifted beyond the nearest safe zone border
  message           String
  resolvedById      String?               @db.Uuid
  resolvedAt        DateTime?
  resolutionNotes   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  patient           User                  @relation("LocationAlertPatient", fields: [patientId], references: [id], onDelete: Cascade)
  trackingSession   TrackingSession?      @relation(fields: [trackingSessionId], references: [id], onDelete: SetNull)
  resolvedBy        User?                 @relation("LocationAlertResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([patientId, status])
}
